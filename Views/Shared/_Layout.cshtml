<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta content="width=device-width, initial-scale=1.0" name="viewport" />
	<title>@ViewData["Title"] - Ouroboros</title>

	@* headscale's palette and dots, wrapped in the obvious ring. Inline so that neither static
	   file middleware nor a /favicon.ico round trip is needed. *@
	<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='11.5' fill='none' stroke='%23f8b5cb' stroke-width='5' stroke-dasharray='59 14' stroke-linecap='round'/%3E%3Ccircle cx='27.5' cy='16' r='3.4' fill='%23f8b5cb'/%3E%3Ccircle cx='12.05' cy='12.05' r='2.75' fill='%238d8d8d'/%3E%3Ccircle cx='19.95' cy='12.05' r='2.75' fill='%238d8d8d'/%3E%3Ccircle cx='12.05' cy='19.95' r='2.75' fill='%238d8d8d'/%3E%3Ccircle cx='19.95' cy='19.95' r='2.75' fill='%238d8d8d'/%3E%3C/svg%3E" />
	
	<style>
		html,
		dialog {
			background: #eee;
			color: #333;
			font-family: sans-serif;
		}

		button,
		a,
		input {
			margin: 0 .15rem;
			padding: .05rem .4rem;
		}

		button,
		a {
			background: transparent;
			transition: background 150ms ease-in-out;
			border: 1px solid currentColor;
			color: inherit;
			text-decoration: none;
			display: inline-block;
		}

		button:hover,
		a:hover {
			background: #ddd;
		}

		dialog {
			filter: drop-shadow(0px 0px 5px);
		}

		@@media (prefers-color-scheme: dark) {
			html,
			dialog {
				background: #222;
				color: #ddd;
			}
	
			button:hover,
			a:hover,
			details.expander > summary:hover {
				background: #444;
			}
	
			input[type=text] {
				background: #151515;
				color: inherit;
				border: 1px solid currentColor;
			}
		}

		.formwrap > form { display: inline; }

		/* a <details> that looks clickable: a bordered bar with a turning chevron and a hint that
		   says what clicking it does. */
		details.expander {
			margin: 1rem 0;
			max-width: 50rem;
			border: 1px solid currentColor;
		}

		details.expander > summary {
			display: flex;
			align-items: center;
			gap: .6rem;
			padding: .6rem .9rem;
			cursor: pointer;
			list-style: none;
			user-select: none;
			transition: background 150ms ease-in-out;
		}

		details.expander > summary::-webkit-details-marker { display: none; }

		details.expander > summary::before {
			content: "\25B8";
			display: inline-block;
			transition: transform 150ms ease-in-out;
		}

		details.expander[open] > summary::before { transform: rotate(90deg); }

		details.expander > summary:hover { background: #ddd; }

		details.expander > summary:focus-visible {
			outline: 2px solid currentColor;
			outline-offset: 2px;
		}

		details.expander[open] > summary { border-bottom: 1px solid currentColor; }

		.expander-title { font-weight: bold; }

		.expander-hint {
			margin-left: auto;
			font-size: .85em;
			opacity: .65;
		}

		.expander-hint::after { content: "Click to show setup steps"; }
		details.expander[open] .expander-hint::after { content: "Click to hide"; }

		.expander-body { padding: 0 1rem .5rem; }

		table { border-collapse: collapse; }
		td {
			border: 1px solid grey;
			padding: .25rem .75rem;
		}

	</style>

	<noscript><style>.js-only { display: none }</style></noscript>
</head>
<body>
	@RenderBody()
</body>
</html>