<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta content="width=device-width, initial-scale=1.0" name="viewport" />
	<title>@ViewData["Title"] - Ouroboros</title>

	@* headscale's palette and dots, wrapped in the obvious ring. Inline so that neither static
	   file middleware nor a /favicon.ico round trip is needed. *@
	<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='11.5' fill='none' stroke='%23f8b5cb' stroke-width='5' stroke-dasharray='59 14' stroke-linecap='round'/%3E%3Ccircle cx='27.5' cy='16' r='3.4' fill='%23f8b5cb'/%3E%3Ccircle cx='12.05' cy='12.05' r='2.75' fill='%238d8d8d'/%3E%3Ccircle cx='19.95' cy='12.05' r='2.75' fill='%238d8d8d'/%3E%3Ccircle cx='12.05' cy='19.95' r='2.75' fill='%238d8d8d'/%3E%3Ccircle cx='19.95' cy='19.95' r='2.75' fill='%238d8d8d'/%3E%3C/svg%3E" />
	
	<style>
		html,
		dialog {
			background: #eee;
			color: #333;
			font-family: sans-serif;
		}

		button,
		a,
		input {
			margin: 0 .15rem;
			padding: .05rem .4rem;
		}

		button,
		a {
			background: transparent;
			transition: background 150ms ease-in-out;
			border: 1px solid currentColor;
			color: inherit;
			text-decoration: none;
			display: inline-block;
		}

		button:hover,
		a:hover {
			background: #ddd;
		}

		dialog {
			filter: drop-shadow(0px 0px 5px);
		}

		@@media (prefers-color-scheme: dark) {
			html,
			dialog {
				background: #222;
				color: #ddd;
			}
	
			button:hover,
			a:hover {
				background: #444;
			}
	
			input[type=text] {
				background: #151515;
				color: inherit;
				border: 1px solid currentColor;
			}
		}

		.formwrap > form { display: inline; }

		table { border-collapse: collapse; }
		td {
			border: 1px solid grey;
			padding: .25rem .75rem;
		}

	</style>

	<noscript><style>.js-only { display: none }</style></noscript>
</head>
<body>
	@RenderBody()
</body>
</html>